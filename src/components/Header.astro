---
const nav = [
  { href: '/alabama/', label: 'Cities' },
  { href: '/#pros', label: 'Browse pros' },
  { href: '/tools/stump-grinding-cost/', label: 'Cost guide' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap inner">
    <a class="logo" href="/" aria-label="Shoals Tree Pros home">
      <span class="mark">
        <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M32 8 L44 26 L37 26 L46 40 L36 40 L36 50 L28 50 L28 40 L18 40 L27 26 L20 26 Z" fill="#2e9e57"/>
          <rect x="26" y="50" width="12" height="6" rx="2" fill="#f2b632"/>
        </svg>
        <span class="dot-accent"></span>
      </span>
      <span>Shoals Tree Pros<small>Tree care directory · The Shoals, AL</small></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <a class="btn btn-gold btn-sm" href="/about/#claim">Add your business</a>
  </div>
</header>
