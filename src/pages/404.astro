---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Shoals Tree Pros" description="That page doesn't exist. Browse Shoals tree service crews instead." path="/404">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That branch is gone</h1>
      <p class="lede">The page you wanted isn't here. The directory is one click away.</p>
      <div style="display: flex; gap: 1rem; margin-top: 1.6rem; flex-wrap: wrap;">
        <a class="btn btn-primary" href="/">Back to the directory</a>
        <a class="btn btn-ghost" href="/alabama/">Browse cities</a>
      </div>
    </div>
  </section>
</Layout>
