---
import Layout from '../../../layouts/Layout.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { cities, cityBySlug } from '../../../data/cities';
import { coreServices } from '../../../data/services';
import { faqsFor } from '../../../data/faqs';
import { allBusinesses, groupForCity } from '../../../lib/biz';

export async function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const businesses = await allBusinesses();
const { inCity, inCounty, serves } = groupForCity(businesses, city.slug, city.name, city.county);
const site = Astro.site?.href ?? '';

const title = `Tree Trimming & Stump Grinding in ${city.name}, AL | Shoals Tree Pros`;
const description = `Independent directory of tree trimming, stump grinding, removal, and storm cleanup crews in ${city.name}, Alabama (${city.county} County). Source-backed listings with contact details.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Alabama', item: `${site}alabama/` },
      { '@type': 'ListItem', position: 3, name: city.name },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Tree services in ${city.name}, Alabama`,
    itemListElement: [...inCity, ...inCounty, ...serves].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site}business/${b.id}/`,
      name: b.data.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqsFor('city').map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} path={`/alabama/${city.slug}/`} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <a href="/alabama/">Alabama</a> <span class="sep">/</span>
      <span class="here">{city.name}</span>
    </nav>
  </div>

  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{city.county} County · Alabama</p>
      <h1>Tree services in {city.name}</h1>
      <p class="lede">{city.blurb} {city.treeNote}</p>
      <div class="svc-links" style="margin-top: 1.4rem; display: flex; gap: 0.6rem; flex-wrap: wrap;">
        {coreServices.map((s) => (
          <a class="btn btn-ghost btn-sm" href={`/alabama/${city.slug}/${s.slug}/`}>{s.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="group-head">
      <h2>In {city.name}</h2>
      <span class="count">{inCity.length}</span>
      {inCity.length === 0 && <span class="note">none based here yet — check nearby crews below</span>}
    </div>
    <div class="cards-grid">{inCity.map((b) => <BusinessCard biz={b} />)}</div>

    {inCounty.length > 0 && (
      <>
        <div class="group-head"><h2>Elsewhere in {city.county} County</h2><span class="count">{inCounty.length}</span></div>
        <div class="cards-grid">{inCounty.map((b) => <BusinessCard biz={b} />)}</div>
      </>
    )}

    {serves.length > 0 && (
      <>
        <div class="group-head"><h2>Regional crews serving {city.name}</h2><span class="count">{serves.length}</span></div>
        <div class="cards-grid">{serves.map((b) => <BusinessCard biz={b} />)}</div>
      </>
    )}

    {inCity.length + inCounty.length + serves.length === 0 && (
      <div class="src-box" style="margin-top: 1.5rem;">
        <strong>No listings for {city.name} yet.</strong> This directory only lists real, source-backed
        businesses — nothing gets invented to fill a page. Meanwhile, crews in
        <a href="/alabama/">nearby Shoals cities</a> commonly serve this area.
      </div>
    )}
  </section>

  <FaqBlock scope="city" heading={`Hiring tree help in ${city.name}`} />

  <section class="wrap" style="padding-block: 1rem 3rem;">
    <div class="cta-box">
      <h2>Work trees in <span class="hl">{city.name}</span>?</h2>
      <p>Your crew should be on this page. Listing is free — claim it, correct it, or get added.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href="/about/#claim">Claim or add your listing</a>
      </div>
    </div>
  </section>
</Layout>
